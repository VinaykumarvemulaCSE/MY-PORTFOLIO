# ---------------------------------------------------------------------------
# Sanity CMS
# ---------------------------------------------------------------------------
# Get these from: manage.sanity.io → your project → Project settings
# Leave them EMPTY to keep using the JSON files in public/data/ (the site will
# still build and deploy). Fill them in to switch the site over to Sanity.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01

# Only required for private datasets. Free-plan datasets are public, so leave
# this empty unless you later restrict reads.
SANITY_API_READ_TOKEN=

# Shared secret for the webhook at /api/revalidate. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Email (contact form)
# ---------------------------------------------------------------------------
# Resend free tier: 3,000 emails/month, 100/day. https://resend.com/api-keys
# Without a key the contact form only logs to the server console — and it will
# tell the visitor it failed, rather than pretending to succeed.
RESEND_API_KEY=

# Where submissions land. Use a mailbox you actually read.
CONTACT_RECIPIENT_EMAIL=kumarvinay072007@gmail.com

# Must be a verified domain in Resend, or Resend's onboarding address while the
# domain is still pending: onboarding@resend.dev
RESEND_SENDER_EMAIL=onboarding@resend.dev

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://vinaykumar.eu.cc
