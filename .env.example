# ---------------------------------------------------------------------------
# Sanity CMS
# ---------------------------------------------------------------------------
# Get these from: manage.sanity.io → your project → Project settings
# Leave them EMPTY to keep using the JSON files in public/data/ (the site will
# still build and deploy). Fill them in to switch the site over to Sanity.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01

# Only required for private datasets. Free-plan datasets are public, so leave
# this empty unless you later restrict reads.
SANITY_API_READ_TOKEN=

# Shared secret for the webhook at /api/revalidate. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# The final production origin, without a trailing slash. Set this in Vercel
# after connecting the new domain. Locally it falls back to localhost, and on
# Vercel previews it falls back to the deployment URL.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Contact
# ---------------------------------------------------------------------------
# There is no email API key. The contact form opens the visitor's mail client
# and sends to the address stored in Sanity → Profile → Contact.
